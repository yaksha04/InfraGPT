# InfraGPT Environment Configuration

# Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Backend Orchestrator
ORCHESTRATOR_PORT=8080

# Kubernetes. mock is the default and never touches a real cluster.
# Set INFRAGPT_K8S_MODE=live only for a cluster you intend this app to manage.
INFRAGPT_K8S_MODE=mock
KUBECONFIG_PATH=~/.kube/config
K8S_IN_CLUSTER=false

# Leave empty for the in-process MCP server. Docker Compose sets this for you.
MCP_SERVER_URL=

# PostgreSQL Database (Audit Logs)
POSTGRES_USER=infragpt
POSTGRES_PASSWORD=infragpt_secret
POSTGRES_DB=infragpt_audit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
